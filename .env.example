# ==============================================================================
# ENVIRONMENT & SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# DATABASE (PostgreSQL / Neon / Supabase)
# ==============================================================================
# Option 1: Connection URL (Khuyên dùng cho Neon / Cloud Postgres)
DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require

# Option 2: Cấu hình thông số DB riêng lẻ (Local PostgreSQL)
# DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=erp_local
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Khóa bí mật ký mã JWT và mã hóa (bắt buộc riêng biệt, tối thiểu 32 ký tự / 256-bit)
# Gợi ý sinh khóa: chạy lệnh `openssl rand -hex 32` trong terminal
JWT_SECRET=your_access_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_refresh_jwt_secret_at_least_32_characters_long
ENCRYPTION_KEY=your_encryption_aes_key_at_least_32_characters_long

# ==============================================================================
# CLOUDINARY (Lưu trữ ảnh & tài liệu đính kèm)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Tùy chọn: Tài khoản Cloudinary phụ cho Video AI (nếu có)
# CLOUDINARY_CLOUD_NAME_1=
# CLOUDINARY_API_KEY_1=
# CLOUDINARY_API_SECRET_1=

# ==============================================================================
# AI SERVICES & TÍCH HỢP BÊN THỨ 3
# ==============================================================================
AI_SERVICE_URL=http://localhost:3010
# KLING_API_KEY=
# ARK_API_KEY=
# N8N_URL=

# ==============================================================================
# GOOGLE INTEGRATION (Google Drive & Google Sheets)
# ==============================================================================
# Tài khoản Google Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ID Bảng tính Google Sheets & Thư mục Google Drive lưu trữ chứng từ
GOOGLE_PAYMENT_REQUEST_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_PAYMENT_REQUEST_SHEET_TAB=TAB
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Tùy chọn: Đường dẫn file JSON service account hoặc xác thực OAuth2 (thay thế Service Account)
# GOOGLE_KEY_FILE=
# GOOGLE_SHEET_TEMPLATE_ID=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# ==============================================================================
# REDIS CACHING (Enterprise Resilient Caching)
# ==============================================================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# ==============================================================================
# CLIENT INTEGRITY & REQUEST SIGNING (API Hardening)
# ==============================================================================
# Khóa công khai RSA cho đối tác Server-to-Server dạng JSON map: {"clientId:version": "PEM_PUBLIC_KEY"}
SERVER_PUBLIC_KEYS_JSON={"partner-service-1:v1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
# Danh sách endpoint công khai bỏ qua kiểm tra chữ ký (phân cách bằng dấu phẩy)
CLIENT_INTEGRITY_PUBLIC_PATHS=/api/health,/api/auth/login,/api/auth/refresh,/api/auth/register
# Tiền tố route cho đối tác (bắt buộc ký RSA)
PARTNER_PATH_PREFIX=/api/partner
# Chế độ xử lý khi Redis gặp sự cố: "closed" (fail-closed, trả 503) hoặc "memory" (fallback tạm trong bộ nhớ)
NONCE_FAIL_MODE=closed
# Bật cờ bypass chữ ký chỉ khi phát triển cục bộ (CẤM bật ở Production)
BYPASS_CLIENT_INTEGRITY=false
